<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StayEase | Your Perfect Getaway</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background-color: #f8f9fa;
    }
    .hero {
      background-image: url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1950&q=80');
      background-size: cover;
      background-position: center;
      height: 80vh;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
    }
    .hero::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background-color: rgba(0, 0, 0, 0.5);
    }
    .hero-content {
      position: relative;
      z-index: 2;
    }
    .btn-custom {
      background-color: #ff6b6b;
      border: none;
      padding: 10px 25px;
      color: white;
      border-radius: 25px;
      transition: 0.3s;
    }
    .btn-custom:hover {
      background-color: #ff4c4c;
    }
  </style>
</head>
<%layout("./layouts/boylerplate.ejs") %>
<body>
  <!-- Navbar -->
  
  <nav class="navbar navbar-expand-lg bg-white shadow-sm py-3">
    <div class="container">
      <a class="navbar-brand fw-bold text-danger" href="/">WanderLust</a>
      <div>
       
      
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <h1 class="display-4 fw-bold">Find Your Perfect Stay</h1>
      <p class="lead mb-4">Book hotels, rent homes, or plan your next holiday — all in one place.</p>
      
    </div>
  </section>

  <!-- Intro Section -->
  <section class="container text-center py-5">
    <h2 class="fw-semibold mb-3">Welcome to WanderLust</h2>
    <p class="text-muted mb-4">A simple and seamless way to find your next getaway. Whether it’s a cozy cabin in the hills, a beach villa, or a city apartment — we’ve got you covered.</p>
    <img src="https://images.unsplash.com/photo-1576678927484-cc907957088c?auto=format&fit=crop&w=900&q=60" 
         class="img-fluid rounded shadow-lg" alt="Beautiful Stay Image">
  </section>

  <footer class="text-center py-4 bg-light">
    <p class="mb-0 text-muted">&copy; 2025 StayEase. Made with ❤️ for travelers.</p>
  </footer>
</body>
</html>
